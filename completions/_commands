#compdef llm_copy.sh llm_git_diff.sh multitail.sh git_clean_branches.sh

case "$service" in
  llm_copy.sh)
    _values 'option' --string --save-path --ignore-gitignore --help -h
    ;;
  llm_git_diff.sh)
    _values 'option' --save-path --exclude-untracked --string --help -h --
    ;;
  multitail.sh|git_clean_branches.sh)
    _values 'option' --help -h
    ;;
esac
