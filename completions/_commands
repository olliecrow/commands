#compdef llm_copy.sh llm_git_diff.sh multitail.sh git_clean_branches.sh clear_notebook_outputs.sh

case "$service" in
  llm_copy.sh)
    _values 'option' --string --save-path --ignore-gitignore --allow-sensitive --help -h
    ;;
  llm_git_diff.sh)
    _values 'option' --save-path --exclude-untracked --string --help -h --
    ;;
  git_clean_branches.sh)
    _values 'option' --dry-run -n --help -h
    ;;
  multitail.sh|clear_notebook_outputs.sh)
    _values 'option' --help -h
    ;;
esac
